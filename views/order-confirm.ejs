<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Confirmation - TechHub Company</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header>
    <div class="container">
      <h1 class="logo">TECHHUB COMPANY</h1>
      <nav>
        <a href="/dashboard">Dashboard</a>
        <a href="/services">Services</a>
        <a href="/logout">Logout (<%= user.username %>)</a>
      </nav>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <h2>Order Submitted — Pending Payment</h2>
      <div class="confirm-box">
        <p><strong>Service:</strong> <%= service.name %><%= optionName ? ' - ' + optionName : '' %></p>
        <p><strong>Total:</strong> <%= formatTZS(finalPrice) %></p>
        <p><strong>Phone:</strong> <%= phone %></p>
        <p><strong>Payment:</strong> <%= payment_network %></p>
        <p><strong>Confirmation Code sent to:</strong> <%= emailSent %></p>
        <div style="background:#fff3cd;color:#664d03;border:1px solid #ffc107;border-radius:8px;padding:12px;margin:12px 0;font-size:0.9rem">
          &#9888; Your order is <strong>not yet confirmed</strong>. Check your email for the confirmation code, make payment, then enter the code below.
        </div>
        <hr />
        <h3>Payment Instructions</h3>
        <p><strong>MIX by YAS:</strong> <%= paymentInfo.mobile.number %> - <%= paymentInfo.mobile.name %></p>
        <p><strong>Equity Bank:</strong> <%= paymentInfo.bank.account %> - <%= paymentInfo.bank.name %></p>
        <hr />
        <p>After making payment, confirm your order below:</p>
        <form method="POST" action="/order/confirm">
          <input type="hidden" name="order_id" value="<%= order_id %>" />
          <input type="text" name="code" placeholder="Enter confirmation code from email" required />
          <button type="submit" class="btn">Confirm Payment</button>
        </form>
        <a href="/dashboard" class="btn" style="background:#444;margin-top:10px;display:inline-block">Go to Dashboard</a>
      </div>
    </div>
  </section>
</body>
</html>
