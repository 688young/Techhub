<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order - TechHub Company</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header>
    <div class="container">
      <h1 class="logo">TECHHUB COMPANY</h1>
      <nav>
        <a href="/dashboard">Dashboard</a>
        <a href="/services">Services</a>
        <a href="/logout">Logout (<%= user.username %>)</a>
      </nav>
    </div>
  </header>
  <section class="section">
    <div class="container">
      <% if (service.needs_quote) { %>
        <h2>Request Service</h2>
        <div class="order-layout">
          <div class="order-details">
            <h3><%= service.name %></h3>
            <p><%= service.long_description %></p>
            <p style="color:var(--accent-1);font-weight:700">&#128205; This service requires a consultation/visit. Our team will contact you with a quote.</p>
            <% if (options.length > 0) { %>
              <div style="margin-top:14px"><strong>Available Packages:</strong>
                <ul style="margin-top:6px;padding-left:18px">
                  <% options.forEach(function(o) { %>
                    <li style="margin-bottom:6px;font-size:0.85rem;color:var(--text-secondary)"><strong><%= o.name %></strong> — <%= o.description %></li>
                  <% }); %>
                </ul>
              </div>
            <% } %>
          </div>
          <div class="order-form">
            <% if (error) { %><p class="error-msg"><%= error %></p><% } %>
            <form method="POST" action="/order/quote">
              <input type="hidden" name="service_id" value="<%= service.id %>" />
              <input type="text" name="name" placeholder="Your Full Name" value="<%= user.username %>" required />
              <input type="text" name="phone" placeholder="Phone Number (e.g. 0618001980)" required />
              <% if (options.length > 0) { %>
                <label>Choose Package:</label>
                <select name="selected_option" style="margin-bottom:10px">
                  <option value="">-- Select a package (optional) --</option>
                  <% options.forEach(function(o) { %>
                    <option value="<%= o.name %>"><%= o.name %></option>
                  <% }); %>
                </select>
              <% } %>
              <select name="location" required>
                <option value="">-- Select Location --</option>
                <option value="Home / Residence">Home / Residence</option>
                <option value="Office">Office</option>
                <option value="Factory / Warehouse">Factory / Warehouse</option>
                <option value="School / Institution">School / Institution</option>
                <option value="Shop / Store">Shop / Store</option>
                <option value="Hotel / Restaurant">Hotel / Restaurant</option>
                <option value="Hospital / Clinic">Hospital / Clinic</option>
                <option value="Other">Other</option>
              </select>
              <input type="number" name="quantity" placeholder="Quantity (e.g. number of units)" min="1" />
              <textarea name="description" placeholder="Describe what you need in detail..." rows="4"></textarea>
              <button type="submit" class="btn">Submit Request</button>
            </form>
          </div>
        </div>
      <% } else { %>
        <h2>Order Service</h2>
        <div class="order-layout">
          <div class="order-details">
            <h3><%= service.name %></h3>
            <p><%= service.long_description %></p>
            <p class="price">Price: <%= formatTZS(service.price) %></p>
          </div>
          <div class="order-form">
            <% if (error) { %><p class="error-msg"><%= error %></p><% } %>
            <form method="POST" action="/order">
              <input type="hidden" name="service_id" value="<%= service.id %>" />
              <% if (options.length > 0) { %>
                <label>Choose Option:</label>
                <select name="service_option_id" id="boostOption" required onchange="toggleBoostFields()">
                  <option value="">-- Select --</option>
                  <% options.forEach(function(o) { %>
                    <option value="<%= o.id %>" <%= queryOpt == o.id ? 'selected' : '' %> data-name="<%= o.name.toLowerCase() %>"><%= o.name %> - <%= formatTZS(o.price) %></option>
                  <% }); %>
                </select>
              <% } %>
              <div id="boostProfileField" style="display:none">
                <input type="url" name="profile_url" placeholder="Profile / Channel URL (e.g. https://instagram.com/yourpage)" />
              </div>
              <div id="boostPostField" style="display:none">
                <input type="url" name="post_link" placeholder="Post Link (e.g. https://instagram.com/p/abc123)" />
              </div>
              <input type="text" name="phone" placeholder="Your Phone Number" required />
              <label>Payment Network:</label>
              <select name="payment_network" required>
                <option value="">-- Select Payment Method --</option>
                <option value="MIX by YAS">MIX by YAS (45490505)</option>
                <option value="Equity Bank">Equity Bank (3015111947559)</option>
              </select>
              <button type="submit" class="btn">Place Order</button>
            </form>
          </div>
        </div>
      <% } %>
    </div>
  </section>
<script>
function toggleBoostFields() {
  var sel = document.getElementById('boostOption');
  if (!sel) return;
  var opt = sel.options[sel.selectedIndex];
  var name = opt ? opt.getAttribute('data-name') || '' : '';
  var profileField = document.getElementById('boostProfileField');
  var postField = document.getElementById('boostPostField');
  if (name.includes('follower') || name.includes('subscriber')) {
    profileField.style.display = 'block';
    postField.style.display = 'none';
  } else if (name.includes('like') || name.includes('view') || name.includes('comment')) {
    profileField.style.display = 'none';
    postField.style.display = 'block';
  } else {
    profileField.style.display = 'none';
    postField.style.display = 'none';
  }
}
toggleBoostFields();
</script>
</body>
</html>